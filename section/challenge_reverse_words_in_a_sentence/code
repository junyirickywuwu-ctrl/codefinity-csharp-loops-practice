using System;

namespace ConsoleApp
{
    public class Program
    {
        public static void Main()
        {
            string input = "Loops make code powerful";
            string reversed = ReverseWords(input);
            Console.WriteLine(reversed); // Output: "powerful code make Loops"
        }

        public static string ReverseWords(string sentence)
        {
            string[] test = sentence.Split(' ',StringSplitOptions.RemoveEmptyEntries);
            string result = "";
            for(int i = test.Length - 1; i >= 0; i--)
            {
                result += test[i];
                if(i > 0)
                {
                    result += " ";
                }
            }
            return result;
        }
    }
}
